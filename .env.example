# Copy to .env and adjust.

# Android package id of the app under test (required).
# List what is installed:  adb shell pm list packages
APP_PACKAGE=com.example.app

# Web host the app wraps, e.g. app.example.com (required; the WebView URL check in the smoke
# spec compares against it).
APP_WEB_HOST=app.example.com

# Optional. Leave empty and Appium resolves the launcher activity itself.
# To look it up:  adb shell cmd package resolve-activity --brief <APP_PACKAGE>
APP_ACTIVITY=

# Optional. Emulator/device serial from `adb devices` (e.g. emulator-5554).
# Leave empty to use the only connected device.
DEVICE_UDID=

# Optional. Path to an .apk to install before the run. Leave empty to test the
# app that is already installed on the device (e.g. from Google Play).
APP_PATH=
